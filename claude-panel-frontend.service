[Unit]
Description=Claude Panel - Vite Frontend Dev Server
After=network-online.target claude-panel.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/tridu33/tmux-coder-panel/frontend
Environment=PATH=/root/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/.nvm/versions/node/v22.22.3/bin/node node_modules/.bin/vite --port 20016 --host 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
