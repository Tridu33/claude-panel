[Unit]
Description=Claude Panel FastAPI Server (port 10015)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/tridu33/tmux-coder-panel
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 10015 --workers 1
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
