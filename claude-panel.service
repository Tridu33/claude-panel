[Unit]
Description=Claude Panel - FastAPI Control Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tridu33
Group=tridu33
WorkingDirectory=/home/tridu33/githubSrc/claude-panel
Environment=PATH=/home/tridu33/globalVenv4uv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/tridu33/globalVenv4uv/bin/python3 main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
